{
  "name": "flowcli",
  "version": "1.0.0",
  "description": "Multi-instance Claude dashboard",
  "main": "dist/main/main.js",
  "scripts": {
    "copy:assets": "cp src/renderer/index.html dist/renderer/index.html && cp src/renderer/styles.css dist/renderer/styles.css && cp node_modules/@xterm/xterm/css/xterm.css dist/renderer/xterm.css",
    "build:renderer": "npx esbuild src/renderer/app.ts --bundle --outfile=dist/renderer/app.js --platform=browser --external:electron",
    "build": "tsc && npm run build:renderer && npm run copy:assets",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.flowcli.app",
    "productName": "FlowCLI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.6.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "node-pty": "^1.1.0"
  }
}
